# Salin file ini menjadi `.env.local` lalu isi sesuai lingkungan Anda.

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=hadir_tadz

# Koneksi ke DB cloud (Vercel + TiDB/Aiven/Clever Cloud) WAJIB TLS.
# Set true saat memakai DB cloud; biarkan kosong/false untuk lokal.
DB_SSL=false
# Verifikasi sertifikat (default true; false hanya untuk DB yang pakai sertifikat self-signed)
DB_SSL_VERIFY=true
# Limit koneksi pool. Default: 5 di Vercel, 10 di hosting lain.
# TiDB/Aiven free tier batasi koneksi (~3-10), sesuaikan kecil.
DB_CONN_LIMIT=5

# Secret untuk menandatangani JWT session.
# Generate nilai acak yang kuat, contoh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wajib berbeda dari default contoh ini saat produksi!
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang